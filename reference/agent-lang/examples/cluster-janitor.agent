# Real Agent — example written in the agent language (.agent)
# Compiles to a JSON document conforming to schemas/agent.schema.json.

agent agent-demo-001 {
  name    "Cluster Janitor"
  version 0.1.0
  type    maintenance

  identity {
    owner     thefractionalpm
    tenant    default
    lifecycle active
  }

  objective "Keep the k3s cluster clean" {
    success    "no completed pods linger longer than 1h"
    constraint "never delete running pods"
  }

  capability cap-list-pods {
    name "list pods"
    risk low
  }

  capability cap-delete-pods {
    name "delete completed pods"
    risk high
  }

  action act-cleanup {
    name       "delete completed pods"
    target     "kube-system/pods?phase=Succeeded"
    reversible false
    approval   required
    policy     required
  }

  policy {
    deny-by-default true
    ref "opa://cluster/cleanup"
  }

  memory {
    enable    working episodic semantic procedural
    retention "30d"
  }

  evaluation {
    metric    "false-deletions"
    metric    "pods-reclaimed"
    min-trust 0.8
  }
}
