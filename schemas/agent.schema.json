{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-agent.dev/schemas/agent.schema.json",
  "title": "Real Agent",
  "description": "Canonical schema for a real agent contract.",
  "type": "object",
  "required": ["agent", "identity", "objective", "capabilities", "actions", "policy", "memory", "evaluation"],
  "properties": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "version", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["owner", "tenant", "lifecycle_state"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string" },
        "subject": { "type": "string" },
        "lifecycle_state": {
          "type": "string",
          "enum": ["draft", "registered", "approved", "active", "paused", "suspended", "revoked", "retired", "archived"]
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "risk_level"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "input_schema": { "type": "string" },
          "output_schema": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "target", "reversible", "approval_required", "policy_required"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "target": { "type": "string" },
          "reversible": { "type": "boolean" },
          "approval_required": { "type": "boolean" },
          "policy_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": ["deny_by_default"],
      "properties": {
        "policy_engine": { "type": "string" },
        "policy_refs": { "type": "array", "items": { "type": "string" } },
        "deny_by_default": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["working", "episodic", "semantic", "procedural", "retention_policy"],
      "properties": {
        "working": { "type": "boolean" },
        "episodic": { "type": "boolean" },
        "semantic": { "type": "boolean" },
        "procedural": { "type": "boolean" },
        "retention_policy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["metrics", "minimum_trust_score"],
      "properties": {
        "metrics": { "type": "array", "items": { "type": "string" } },
        "test_suite": { "type": "string" },
        "minimum_trust_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
